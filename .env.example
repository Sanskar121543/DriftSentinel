# DriftSentinel — Environment Variables
# Copy to .env and fill in your values:
#   cp .env.example .env

# ─── LLM / OpenAI ─────────────────────────────────────────
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small

# ─── Pinecone (RAG vector store) ──────────────────────────
PINECONE_API_KEY=...
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ─── Kafka ────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_SECURITY_PROTOCOL=SASL_SSL   # Confluent Cloud
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=...
# KAFKA_SASL_PASSWORD=...

# ─── MLflow ───────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=driftsentinel

# ─── Drift detection thresholds (optional overrides) ──────
DRIFT_WINDOW_MINUTES=5
DRIFT_MIN_ALERT_TESTS=2
DRIFT_KS_PVALUE_THRESHOLD=0.05
DRIFT_PSI_THRESHOLD=0.2
DRIFT_JS_THRESHOLD=0.1
DRIFT_SHAP_DELTA_THRESHOLD=0.15

# ─── Retraining ───────────────────────────────────────────
RETRAINING_COST_CEILING_USD=50.0

# ─── Jira (optional — canary rollback tickets) ────────────
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_PROJECT_KEY=DS
JIRA_EMAIL=your@email.com
JIRA_API_TOKEN=...

# ─── GCP (optional — production infra) ────────────────────
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GCP_PROJECT=your-project-id

# ─── Kubernetes (optional) ────────────────────────────────
# K8S_IN_CLUSTER=false
# K8S_NAMESPACE=driftsentinel

# ─── App ──────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | text
